{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    { "source": "/assets/v3/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }] },
    { "source": "/assets/(v4|v7|v8)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }] },
    { "source": "/assets/pedir/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/(i18n\\.js|i18n\\.css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] },
    { "source": "/(robots\\.txt|sitemap\\.xml)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/llms.txt", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/site.webmanifest", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/menu.pdf", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
